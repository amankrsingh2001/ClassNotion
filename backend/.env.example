# Paste the PostgreSQL URL from Neon > Connect. Keep sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Optional: defaults to DATABASE_URL with Neon's -pooler hostname removed.
# DIRECT_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=4000
FRONTEND_URL="https://class-notion.vercel.app"
# Existing integrations, required for their respective features:
MAIL_HOST=""
MAIL_USER=""
MAIL_PASS=""
CLOUD_NAME=""
API_KEY=""
API_SECRET=""
FOLDER_NAME="ClassNotion"
RAZORPAY_KEY=""
RAZORPAY_SECRET=""
